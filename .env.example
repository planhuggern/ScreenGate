# Copy to .env and choose a unique password (at least 12 characters).
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PATH=/admin
SCREENGATE_TIMEZONE=Europe/Oslo
SCREENGATE_PORT=8081
# 127.0.0.1 exposes only to this machine. For your private LAN, set the
# server's LAN address (or 0.0.0.0) and restrict access in your firewall.
# Use an HTTPS reverse proxy before sending credentials over an untrusted network.
SCREENGATE_BIND=127.0.0.1
# For a reverse proxy, list its exact browser origin(s), comma-separated.
# SCREENGATE_TRUSTED_ORIGINS=https://screen.example.no
